// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "bindings": {
      "ctrl-shift-p": "command_palette::Toggle",
      "ctrl-shift-k": "zed::OpenKeymap",
      "ctrl-shift-x": "zed::Extensions",
      "ctrl-alt-n": "task::Spawn",
      "ctrl-alt-r": "task::Rerun",
      "ctrl-shift-o": "workspace::OpenFiles",
      "ctrl-alt-o": "workspace::Open",
      "ctrl-\\": "workspace::NewCenterTerminal",
      "space f t": "terminal_panel::ToggleFocus",
      "space d a": "debugger::Start",
      "space t b": "workspace::ToggleBottomDock",
      "space t r": "workspace::ToggleRightDock",
      "space t l": "workspace::ToggleLeftDock",
      "space t s": "multi_workspace::ToggleWorkspaceSidebar",
      "space t z": "workspace::ToggleEditorZoom",
      "ctrl-right": "vim::ResizePaneRight",
      "ctrl-left": "vim::ResizePaneLeft",
      "ctrl-down": "vim::ResizePaneDown",
      "ctrl-up": "vim::ResizePaneUp",
    },
  },
  // {
  //   "context": "Workspace",
  //   "bindings": {
  //     "shift shift": "workspace::NewSearch",
  //   },
  // },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-a": "editor::SelectAll",
      "ctrl-w": "pane::CloseActiveItem",
      "alt-enter": "editor::ToggleCodeActions",
    },
  },
  {
    "context": "Editor && vim_mode == insert && !menu",
    "bindings": {
      "j j": "vim::NormalBefore",
    },
  },
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      "space b b": "pane::ActivateLastItem",
      "space b N": "pane::ActivatePreviousItem",
      "space b n": "pane::ActivateNextItem",
      "space b d": "pane::CloseActiveItem",
      "space b l": "pane::CloseItemsToTheLeft",
      "space b r": "pane::CloseItemsToTheRight",
      "space b o": "pane::CloseOtherItems",
      "space b p": "pane::TogglePinTab",
      "space b O": "pane::CloseAllItems",
      "space w k": "pane::SplitUp",
      "space w j": "pane::SplitDown",
      "space w h": "pane::SplitLeft",
      "space w l": "pane::SplitRight",
      "K": "editor::Hover",
      "H": ["editor::MoveToBeginningOfLine", { "stop_at_indent": true }],
      "L": "editor::MoveToEndOfLine",
      "g b": "pane::GoBack",
      "g r": "editor::GoToTypeDefinition",
      "g i": "editor::GoToImplementation",
      "space c f": "editor::Format",
      "space c r": "editor::Rename",
      // "space e": "project_panel::ToggleFocus",
      "space e": "workspace::ToggleRightDock",
      "space t b": "workspace::ToggleBottomDock",
      "space f o": "outline::Toggle",
      "space f p": "projects::OpenRecent",
      "space f f": "file_finder::Toggle",
      "space space": "file_finder::Toggle",
      "space g [": "editor::GoToPreviousHunk",
      "space g ]": "editor::GoToHunk",
      "space m o": "markdown::OpenPreview",
      "space m p": "markdown::OpenPreviewToTheSide",
      "space o": "tab_switcher::Toggle",
      "space p d": "diagnostics::Deploy",
      "space g b": "git::Blame",
      "space g d": "editor::ToggleSelectedDiffHunks",
      "space g r": "git::Restore",
      "space d b": "editor::ToggleBreakpoint",
    },
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "L": "editor::SelectToEndOfLine",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "j": "menu::SelectNext",
      "k": "menu::SelectPrevious",
      "a": "project_panel::NewFile",
      "A": "project_panel::NewDirectory",
      "y": "project_panel::Copy",
      "d": "project_panel::Delete",
      "p": "project_panel::Paste",
      "r": "project_panel::Rename",
      "x": "project_panel::Cut",
      "y p": "workspace::CopyPath",
      "y r": "workspace::CopyRelativePath",
      "space e": "workspace::ToggleRightDock",
    },
  },
  {
    "context": "Workspace && debugger_session",
    "use_key_equivalents": true,
    "bindings": {
      "f6": "debugger::Pause",
      "space d t": "debugger::Stop",
      "ctrl-shift-f5": "debugger::RerunSession",
    },
  },
  {
    "context": "Workspace && debugger_stopped",
    "use_key_equivalents": true,
    "bindings": {
      "f5": "debugger::Continue",
      "f10": "debugger::StepOver",
      "f11": "debugger::StepInto",
      "shift-f11": "debugger::StepOut",
    },
  },
  {
    "context": "Dock || Terminal || Editor",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "space f t": "workspace::ToggleBottomDock",
    },
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "L": "editor::SelectToEndOfLine",
    },
  },
]
